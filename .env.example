# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for OAuth redirects and links in Discord posts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord
# Webhook for #bot-feed (level ups, new lessons, battle results)
DISCORD_WEBHOOK_URL=
# Webhook for #announcements (optional, falls back to DISCORD_WEBHOOK_URL)
DISCORD_ANNOUNCE_WEBHOOK_URL=
# Invite link shown on the landing page
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
